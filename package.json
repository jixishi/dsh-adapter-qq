{
  "name": "dsh-adapter-qq",
  "version": "0.2.1",
  "description": "DeepSeek Harness QQ Bot Adapter - C2C chat, session sync, rich media, skills/MCP management, text-to-image tools",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/all.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq-bot",
    "adapter"
  ],
  "author": "JiXieShi <lydxh935227514@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixishi/dsh-adapter-qq.git"
  },
  "homepage": "https://github.com/jixishi/dsh-adapter-qq#readme",
  "bugs": {
    "url": "https://github.com/jixishi/dsh-adapter-qq/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@flukxr/typst-cli": "0.15.1-npm.0",
    "@fontpkg/lxgw-neo-xi-hei": "1.110.0",
    "noto-color-emoji": "1.0.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "license": "MIT"
}
